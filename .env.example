# Leaderboard database (Supabase). Copy this file to .env.local and fill in both values.
# Supabase dashboard > Project Settings > API (URL) and API Keys (secret key).

# Project URL. NEXT_PUBLIC_SUPABASE_URL is accepted as well.
SUPABASE_URL=

# Secret key (sb_secret_...) or the legacy service_role key. SUPABASE_SECRET_KEY is accepted as well.
# Server-only: never prefix it with NEXT_PUBLIC_. The publishable key will not work here.
SUPABASE_SERVICE_ROLE_KEY=

# Optional and public (safe to expose).
# An address players can write to about a leaderboard name. Shown on the leaderboard and privacy pages.
NEXT_PUBLIC_CONTACT_EMAIL=
# The site's own address, for link previews and the sitemap. Set it when you use a custom domain.
NEXT_PUBLIC_SITE_URL=
